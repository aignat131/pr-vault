rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PR records: authenticated users can read all, write their own
    match /records/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.userId
            || request.auth.token.email == 'aignat131@gmail.com');
    }

    // User profiles: anyone can read, users can write their own
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Exercises: anyone can read, admin can write
    match /exercises/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'aignat131@gmail.com';
    }

    // App config (hidden exercises etc): anyone can read, admin can write
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'aignat131@gmail.com';
    }
  }
}
